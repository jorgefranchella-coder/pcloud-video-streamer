{
  "name": "pcloud-video-streamer",
  "version": "1.0.0",
  "description": "Lightweight web video streamer for pCloud mounted directories",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "index": "node indexer.js",
    "pipeline": "node pipeline.js",
    "inventory": "INDEX_MODE=inventory node indexer.js",
    "analyze": "node visual-analyzer.js",
    "faces": "node face-indexer.js",
    "faces:setup": "bash scripts/setup-face-runtime.sh",
    "backup": "node scripts/backup-data.js",
    "verify-backup": "node scripts/verify-backup.js",
    "restore-data": "node scripts/restore-data.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mime-types": "^2.1.35"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
