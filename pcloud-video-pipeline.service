[Unit]
Description=pCloud technical and visual video metadata pipeline
After=network-online.target rclone-pcloud.service
Wants=network-online.target rclone-pcloud.service

[Service]
Type=oneshot
TimeoutStartSec=0
User=jorge
Group=jorge
WorkingDirectory=/home/jorge/orca/workspaces/Video-Home/meta-data-videos
Environment="VIDEO_ROOT=/mnt/pcloud/My Videos"
Environment="DATA_DIR=/home/jorge/orca/workspaces/Video-Home/meta-data-videos/data"
Environment=MAX_VISUAL=5
EnvironmentFile=/etc/pcloud-video-visual.env
ExecStart=/home/jorge/.hermes/node/bin/node pipeline.js
StandardOutput=journal
StandardError=journal
