[Unit]
Description=pCloud Video Streamer
After=network-online.target rclone-pcloud.service
Wants=network-online.target rclone-pcloud.service

[Service]
Type=simple
User=jorge
Group=jorge
WorkingDirectory=/home/jorge/orca/workspaces/Video-Home/meta-data-videos
Environment="VIDEO_ROOT=/mnt/pcloud/My Videos"
Environment="DATA_DIR=/home/jorge/orca/workspaces/Video-Home/meta-data-videos/data"
Environment=PORT=3001
Environment=NODE_ENV=production
EnvironmentFile=-/etc/pcloud-video-metadata.env
EnvironmentFile=-/etc/pcloud-video-access.env
EnvironmentFile=-/etc/pcloud-video-visual.env
ExecStart=/home/jorge/.hermes/node/bin/node server.js
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
