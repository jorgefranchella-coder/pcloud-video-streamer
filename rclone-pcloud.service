[Unit]
Description=rclone mount pCloud My Videos
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=jorge
Group=jorge
Environment=RCLONE_CONFIG=/home/jorge/.config/rclone/rclone.conf
ExecStart=/usr/bin/rclone mount "pcloud:My Videos" "/mnt/pcloud/My Videos" \
  --vfs-cache-mode full \
  --vfs-cache-max-size 10G \
  --vfs-read-chunk-size 16M \
  --vfs-read-chunk-size-limit 256M \
  --buffer-size 256M \
  --dir-cache-time 1000h \
  --poll-interval 1m \
  --umask 002 \
  --allow-other \
  --allow-non-empty \
  --default-permissions
ExecStop=/bin/fusermount3 -u "/mnt/pcloud/My Videos"
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

[Install]
WantedBy=multi-user.target